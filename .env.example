# ==============================================================================
# ORCA Environment Configuration Template
# Copy this file to .env and supply your credentials. Never commit .env to git.
# ==============================================================================

# Database (PostgreSQL + Psycopg 3)
DATABASE_URL=postgresql+psycopg://orca:orca@localhost:5432/orca_db
DB_ECHO=false

# LLM Providers (Priority: Groq -> Gemini -> OpenRouter)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
DEFAULT_LLM_PROVIDER=groq
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=30

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_STR=/api/v1
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# External Data Services & Timeouts
OPEN_METEO_BASE_URL=https://marine-api.open-meteo.com/v1/marine
EXTERNAL_REQUEST_TIMEOUT_SECONDS=20

# Storage & Cache
DATA_DIR=/home/ckirankumar/orca/data

# Frontend (for Vite client)
VITE_API_BASE_URL=http://localhost:8000/api/v1
