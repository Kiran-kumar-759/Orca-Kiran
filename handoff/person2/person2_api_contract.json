          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by Saffir-Simpson category",
              "title": "Category"
            },
            "description": "Filter by Saffir-Simpson category"
